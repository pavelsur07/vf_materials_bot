# /etc/systemd/system/vf-materials-bot.service
[Unit]
Description=Vash Findir telegram bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vashfindir
EnvironmentFile=/opt/vashfindir/.env
ExecStart=/opt/vashfindir/.venv/bin/python -m vashfindir.apps.bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

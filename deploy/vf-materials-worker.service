# /etc/systemd/system/vf-materials-worker.service
[Unit]
Description=Vash Findir background worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vf_materials_bot
EnvironmentFile=/opt/vf_materials_bot/.env
ExecStart=/opt/vf_materials_bot/.venv/bin/python -m bot.worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Токен бота из @BotFather
BOT_TOKEN=

# Канал, на который нужно подписаться (ID вида -1001234567890)
TELEGRAM_CHANNEL_ID=
# Ссылка на канал для кнопки «Подписаться на канал»
TELEGRAM_CHANNEL_URL=https://t.me/vashfindir
# URL лид-магнита, который выдаётся после подписки
LEADMAGNET_URL=

# Режим: polling (локальная разработка) или webhook (прод)
MODE=polling

# Webhook (прод): публичный URL = WEBHOOK_HOST + WEBHOOK_PATH
# Например: https://mybots.vashfindir.ru/vashfindir
WEBHOOK_HOST=https://mybots.vashfindir.ru
WEBHOOK_PATH=/vashfindir
# Секрет для проверки, что апдейты шлёт именно Telegram (задать случайную строку)
WEBHOOK_SECRET=

# Локальный HTTP-сервер, который проксирует nginx
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8081

# Веб-админка (bot/admin): отдельный процесс, python -m bot.admin
# Ключ подписи сессионной куки — случайная строка (например: openssl rand -hex 32)
ADMIN_SECRET_KEY=
# Логин администратора
ADMIN_USERNAME=admin
# Bcrypt-хэш пароля: uv run python -m bot.admin.hashpw
ADMIN_PASSWORD_HASH=
# Локальный порт админки (nginx проксирует сюда location /admin/)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8082

# Публичный API для бизнес-интеграций (bot/api): отдельный процесс, python -m bot.api.
# Токен машинных клиентов (заголовок x-api-token); legacy-заголовок x-lead-token
# с LEAD_API_TOKEN тоже принимается — сайт не меняет интеграцию.
# Пусто — deploy.sh не перезапускает сервис API.
API_TOKEN=
# Локальный порт API (nginx проксирует сюда location /api/)
API_HOST=127.0.0.1
API_PORT=8083
# Документация API для партнёров: «» — выключено. Значение /api/docs даёт
# Swagger UI на /api/docs, ReDoc на /api/docs/redoc. Путь в nginx-mybot.conf
# (location /api/docs) должен совпадать с этим значением.
API_DOCS_PATH=
# Basic auth для /api/docs (htpasswd генерирует deploy.sh при деплое).
# Пусто — docs закрыты для всех (nginx отдаёт 401).
API_DOCS_USER=
API_DOCS_PASSWORD=

# Фоновый воркер (bot/worker): забирает задачи из очереди jobs в общей SQLite.
# true — deploy.sh перезапускает сервис воркера; иначе воркер не трогаем.
WORKER_ENABLED=false

DATABASE_URL=sqlite+aiosqlite:///./data/vf_materials_bot.db

# GlitchTip / Sentry (оставить пустым, если не используется)
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=production
GLITCHTIP_TRACES_SAMPLE_RATE=0.0

# --- Уведомления о лидах с сайта ---
# Сайт (RU, доступа к api.telegram.org нет) шлёт готовый текст на POST /api/leads,
# бот (NL) пересылает его в Telegram.
# Общий секрет сайта и бота (одинаковый в .env бота и в VF_LEAD_API_TOKEN на сайте).
# Пусто — релей выключен.
LEAD_API_TOKEN=
# Чат или канал для уведомлений о лидах (ID вида -1001234567890)
LEADS_CHAT_ID=
# ID топика (вкладки) форум-группы; пусто или 0 — слать в общий чат
LEADS_TOPIC_ID=
